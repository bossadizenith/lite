{
  "name": "@lite/db",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsdown src/index.ts src/schema.ts src/types.ts --format esm,cjs --dts -d dist --tsconfig tsconfig.build.json",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "tsx node_modules/drizzle-kit/bin.cjs studio"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs",
      "default": "./dist/schema.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "default": "./dist/types.js"
    }
  },
  "devDependencies": {
    "@lite/env": "workspace:*",
    "@lite/eslint-config": "workspace:*",
    "@lite/typescript-config": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@types/node": "^20",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.1",
    "tsdown": "^0.21.9",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.1",
    "postgres": "^3"
  }
}
