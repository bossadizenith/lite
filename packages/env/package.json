{
  "name": "@lite/env",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs",
      "default": "./dist/client.mjs"
    },
    "./client.js": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs",
      "default": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs",
      "default": "./dist/server.mjs"
    },
    "./server.js": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs",
      "default": "./dist/server.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown client.ts server.ts --format esm,cjs --dts -d dist && cp dist/client-*.d.ts dist/client.d.ts 2>/dev/null || true && cp dist/server-*.d.ts dist/server.d.ts 2>/dev/null || true"
  },
  "devDependencies": {
    "@lite/eslint-config": "workspace:*",
    "@lite/typescript-config": "workspace:*",
    "@types/node": "^20"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "dotenv": "^16.5.0",
    "tsdown": "^0.21.9",
    "zod": "^4.0.14"
  }
}
