{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",

    "FRONTEND_URL",
    "BACKEND_URL",

    "NEXT_PUBLIC_BACKEND_URL",
    "NEXT_PUBLIC_FRONTEND_URL",

    "TRUSTED_ORIGINS",

    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "AWS_BUCKET_URL",
    "ECS_CLUSTER_ARN",
    "ECS_TASK_DEFINITION_ARN",
    "SUBNET_1",
    "SUBNET_2",
    "SUBNET_3",
    "SECURITY_GROUP",

    "REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
